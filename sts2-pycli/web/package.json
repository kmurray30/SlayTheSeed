{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:static": "VITE_WORKBENCH_MODE=static vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_WORKBENCH_MODE=static vite build",
    "lint": "eslint .",
